<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GlideTK</RootNamespace>
    <AssemblyName>GlideTK</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Product>GlideTK</Product>
    <Copyright>Copyright © Nikolai Voronin 2016-2026</Copyright>
    <OutputPath>..\bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK" Version="4.9.4" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="shaders\fragment.c;shaders\vertex.c;shaders\text_vertex.c;shaders\text_fragment.c" />
    <None Include="scenes\*.scene" CopyToOutputDirectory="PreserveNewest" />
    <None Include="scripts\run-*.cmd" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Update="scenes\*.scene">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
