# Every primitive and operation of the scene language, run: GlideTK.exe scenes/showcase.scene
# Formulas: https://iquilezles.org/articles/distfunctions/

plane (0, 1, 0) 0

# primitives, a row along X at z = -8
translate (0, 1.5, -8) {
    translate (-60, 0, 0) { sphere 1 color (1, 0.5, 0.4) }
    translate (-56, 0, 0) { box (1, 1, 1) }
    translate (-52, 0, 0) { roundbox (0.8, 0.8, 0.8) 0.2 }
    translate (-48, 0, 0) { boxframe (1, 1, 1) 0.1 }
    translate (-44, 0, 0) { torus 1 0.3 }
    translate (-40, 0, 0) { cappedtorus 120 1 0.25 }
    translate (-36, 0, 0) { link 0.5 0.6 0.2 }
    translate (-32, 0, 0) { cylinder 0.8 1 }
    translate (-28, 0, 0) { segcylinder (-0.8, -0.8, 0) (0.8, 0.8, 0) 0.4 }
    translate (-24, 0, 0) { roundcylinder 0.8 0.2 1 }
    translate (-20, 1, 0) { cone 30 2 }
    translate (-16, 0, 0) { cappedcone 1 1 0.4 }
    translate (-12, 0, 0) { segcone (0, -1, 0) (0, 1, 0) 1 0.3 }
    translate (-8, -1, 0) { solidangle 40 2 }
    translate (-4, 0, 0) { cutsphere 1 0.4 }
    translate (0, 0, 0) { cuthollowsphere 1 0.4 0.08 }
    translate (4, 0, 0) { deathstar 1 0.8 0.8 }
    translate (8, -1, 0) { roundcone 0.8 0.3 1.8 }
    translate (12, 0, 0) { segroundcone (0, -1, 0) (0.5, 1, 0) 0.7 0.3 }
    translate (16, 0, 0) { ellipsoid (1.2, 0.7, 0.9) }
    translate (20, 0, 0) { rhombus 1 0.6 0.2 0.1 }
    translate (24, 0, 0) { octahedron 1.2 }
    translate (28, -1, 0) { scale 2 { pyramid 1 } }
    translate (32, 0, 0) { hexprism 0.9 0.5 }
    translate (36, 0, 0) { triprism 1.5 0.5 }
    translate (40, 0, 0) { capsule (-0.7, -0.7, 0) (0.7, 0.7, 0) 0.4 }
    translate (44, -1, 0) { vcapsule 2 0.5 }
    translate (48, 0, 0) { triangle (-1, -1, 0) (1, -1, 0) (0, 1, 0) }
    translate (52, 0, 0) { quad (-1, -1, 0) (1, -1, 0) (1, 1, 0) (-1, 1, 0) }
}

# infinite primitives
translate (-64, 0, -8) { infcylinder 0.5 color (0.6, 0.8, 1) }
translate (-68, 6, -8) { infcone 15 color (0.6, 0.8, 1) }

# operations, a row along X at z = -16
translate (0, 1.5, -16) {
    translate (-24, 0, 0) { union { box (0.8, 0.8, 0.8) sphere 1.1 color (1, 0.5, 0.4) } }
    translate (-20, 0, 0) { subtract { box (0.8, 0.8, 0.8) sphere 1.1 color (1, 0.5, 0.4) } }
    translate (-16, 0, 0) { intersect { box (0.8, 0.8, 0.8) sphere 1.1 color (1, 0.5, 0.4) } }
    translate (-12, 0, 0) { xor { box (0.8, 0.8, 0.8) sphere 1.1 color (1, 0.5, 0.4) } }
    translate (-8, 0, 0) { smooth 0.3 { box (0.8, 0.8, 0.8) translate (0, 1, 0) { sphere 0.7 color (1, 0.5, 0.4) } } }
    translate (-4, 0, 0) { smoothsubtract 0.2 { box (0.8, 0.8, 0.8) sphere 1.1 } }
    translate (0, 0, 0) { smoothintersect 0.2 { box (0.8, 0.8, 0.8) sphere 1.1 } }
    translate (4, 0, 0) { round 0.2 { box (0.6, 0.6, 0.6) } }
    translate (8, 0, 0) { subtract { onion 0.1 { sphere 1 } translate (0, 0, 1) { box (2, 2, 1) } } }
    translate (12, 0, 0) { elongate (0.8, 0, 0) { sphere 0.6 } }
    translate (16, 0, 0) { twist 1.5 { box (0.5, 1.2, 0.5) } }
    translate (20, 0, 0) { bend 0.3 { box (1.5, 0.3, 0.5) } }
    translate (24, 0, 0) { revolve 1 { box (0.3, 0.6, 0.3) } }
    translate (28, 0, 0) { extrude 0.3 { octahedron 1 } }
    translate (32, 0, 0) { displace 0.1 6 { sphere 1 } }
    translate (36, 0, 0) { mirror (1, 0, 0) { translate (0.8, 0, 0) { sphere 0.5 } } }
    translate (40, -1, 0) { repeat (1.2, 0, 1.2) limit (1, 0, 1) { sphere 0.4 } }
    translate (44, 0, 0) { rotate (0, 45, 30) { box (1, 0.3, 0.6) } }
}
