# A Doric temple in the spirit of the Parthenon, run: GlideTK.exe scenes/parthenon.scene
#
# Peripteral 8 x 17 columns on a three-step crepidoma, entablature with triglyphs,
# gable roof with recessed pediments, a cella with a door and Athena inside.
# The long axis is X, the facade faces +X (the player starts at x = 3 looking at it).
# Columns are spaced 3.4 apart with radius 0.65: the player (radius 1) walks between them.
#
# Temple center x = -36, heights: steps 0..1.2, columns 1.2..9.2, architrave 9.2..10.4,
# frieze 10.4..11.7, cornice 11.7..12.1, roof 12.1..15.2

# ground
plane (0, 1, 0) 0 color (0.72, 0.66, 0.55)

translate (-36, 0, 0) {

    # crepidoma: three steps -----------------------------------------------------
    translate (0, 0.2, 0) { box (29.6, 0.2, 14.3) }
    translate (0, 0.6, 0) { box (29.1, 0.2, 13.8) }
    translate (0, 1.0, 0) { box (28.6, 0.2, 13.3) }

    # peristyle: 17 columns on each long side ------------------------------------
    mirror (0, 0, 1) {
        translate (0, 1.2, 11.9) {
            repeat (3.4, 0, 0) limit (8, 0, 0) {
                translate (0, 3.6, 0) { cappedcone 3.6 0.65 0.52 }      # shaft with entasis
                translate (0, 7.45, 0) { cappedcone 0.25 0.52 0.8 }     # echinus
                translate (0, 7.85, 0) { box (0.85, 0.15, 0.85) }       # abacus
            }
        }
    }

    # peristyle: 6 more columns on each front, corners are shared with the sides -
    mirror (1, 0, 1) {
        translate (27.2, 1.2, 5.1) {
            repeat (0, 0, 3.4) limit (0, 0, 1) {
                translate (0, 3.6, 0) { cappedcone 3.6 0.65 0.52 }
                translate (0, 7.45, 0) { cappedcone 0.25 0.52 0.8 }
                translate (0, 7.85, 0) { box (0.85, 0.15, 0.85) }
            }
        }
    }

    # pronaos and opisthodomos: an inner row of 6 columns at each end ------------
    mirror (1, 0, 1) {
        translate (23.8, 1.2, 5.1) {
            repeat (0, 0, 3.4) limit (0, 0, 1) {
                translate (0, 3.6, 0) { cappedcone 3.6 0.6 0.48 }
                translate (0, 7.45, 0) { cappedcone 0.25 0.48 0.75 }
                translate (0, 7.85, 0) { box (0.8, 0.15, 0.8) }
            }
        }
    }

    # cella with the door to the east --------------------------------------------
    subtract {
        translate (0, 5.2, 0) { box (20, 4, 7.5) }
        translate (0, 5.1, 0) { box (19.2, 3.7, 6.7) }              # interior
        translate (20, 3.8, 0) { box (1, 2.4, 1.6) }                # door
    }

    # Athena Parthenos, gold and ivory -------------------------------------------
    translate (-12, 1.4, 0) {
        translate (0, 0.3, 0) { box (1.4, 0.3, 1.4) color (0.95, 0.92, 0.82) }              # pedestal
        translate (0, 1.8, 0) { roundcone 1.2 0.45 3.6 color (0.95, 0.75, 0.3) }            # robe
        translate (0, 6.3, 0) { sphere 0.5 color (0.95, 0.92, 0.82) }                       # head
        translate (0, 6.6, 0) { cutsphere 0.6 0 color (0.95, 0.75, 0.3) }                   # helmet
        translate (0.3, 3.8, 1.7) {                                                         # shield, facing the door
            rotate (0, 0, 90) {
                torus 1.1 0.12 color (0.95, 0.75, 0.3)
                cylinder 1.0 0.06 color (0.95, 0.75, 0.3)
            }
        }
        segcylinder (0.4, 0, -1.8) (0.4, 6.6, -1.8) 0.07 color (0.95, 0.75, 0.3)            # spear
        translate (0.4, 7.1, -1.8) { cone 12 0.6 color (0.95, 0.75, 0.3) }
    }

    # entablature ----------------------------------------------------------------
    translate (0, 9.8, 0) { box (28.1, 0.6, 12.8) }                 # architrave and the peristyle ceiling
    translate (0, 11.05, 0) { box (27.9, 0.65, 12.6) }              # frieze

    # triglyphs, two per column, painted blue
    mirror (0, 0, 1) {
        translate (0, 11.05, 12.65) {
            repeat (1.7, 0, 0) limit (16, 0, 0) { box (0.3, 0.6, 0.08) color (0.3, 0.4, 0.65) }
        }
    }
    mirror (1, 0, 0) {
        translate (27.95, 11.05, 0) {
            repeat (0, 0, 1.7) limit (0, 0, 7) { box (0.08, 0.6, 0.3) color (0.3, 0.4, 0.65) }
        }
    }

    translate (0, 11.9, 0) { box (28.6, 0.2, 13.3) }                # cornice

    # gable roof, 13 degrees: below both sloped planes and above its base,
    # minus the recessed pediments at both ends
    translate (0, 12.1, 0) {
        subtract {
            intersect {
                box (28.6, 3.2, 13.3)
                plane (0, -1, 0) 0
                translate (0, 3.07, 0) { rotate (13, 0, 0) { plane (0, 1, 0) 0 } }
                translate (0, 3.07, 0) { rotate (-13, 0, 0) { plane (0, 1, 0) 0 } }
            }
            mirror (1, 0, 0) {
                translate (28.6, 0.35, 0) {
                    intersect {
                        box (0.4, 3, 12.3)
                        plane (0, -1, 0) 0
                        translate (0, 2.84, 0) { rotate (13, 0, 0) { plane (0, 1, 0) 0 } }
                        translate (0, 2.84, 0) { rotate (-13, 0, 0) { plane (0, 1, 0) 0 } }
                    }
                }
            }
        }
    }

    # acroteria on the roof corners and peaks
    mirror (1, 0, 0) {
        translate (28.4, 15.1, 0) { octahedron 0.6 color (0.95, 0.75, 0.3) }
        mirror (0, 0, 1) {
            translate (28.4, 12.5, 13.1) { octahedron 0.4 color (0.95, 0.75, 0.3) }
        }
    }
}

# olive trees along the way --------------------------------------------------------
mirror (0, 0, 1) {
    translate (-36, 0, 19) {
        repeat (9, 0, 0) limit (4, 0, 0) {
            vcapsule 2.5 0.25 color (0.45, 0.33, 0.22)
            translate (0, 3.6, 0) { ellipsoid (1.8, 1.3, 1.8) color (0.38, 0.5, 0.32) }
        }
    }
}
