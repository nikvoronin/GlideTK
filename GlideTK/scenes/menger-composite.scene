# Menger sponge you can walk in, run: GlideTK.exe scenes/menger-composite.scene
#
# A cube of side 54 minus crosses of square bars at four levels: every level divides
# the cells by 3, so the holes are 18, 6, 2 and 0.67 wide. A cross is three bars along
# X, Y and Z centered in its cell; repeat ... limit puts 1, 3, 9 and 27 crosses per axis.
# The holed sides take the color of their level.
#
# The sponge sits 0.1 deeper than the plane so that the floor is flat: the big side tunnels lie on the
# ground and lead from every side into the central hall (the player starts at x = 3
# in front of the east tunnel). Tunnels of 6 start 6 above the floor, fly up with SPACE.

plane (0, 1, 0) 0 color (0.55, 0.58, 0.5)

translate (-30, 8.9, 0) {
	subtract {
		box (27, 27, 27) color (0.9, 0.88, 0.82)

		# level 1: holes of 18, one cross
		box (100, 9, 9) color (0.85, 0.55, 0.35)
		box (9, 100, 9) color (0.85, 0.55, 0.35)
		box (9, 9, 100) color (0.85, 0.55, 0.35)

		# level 2: holes of 6 in cells of 18
		repeat (18, 18, 18) limit (1, 1, 1) {
			box (100, 3, 3) color (0.4, 0.65, 0.75)
			box (3, 100, 3) color (0.4, 0.65, 0.75)
			box (3, 3, 100) color (0.4, 0.65, 0.75)
		}

		# level 3: holes of 2 in cells of 6
		repeat (6, 6, 6) limit (4, 4, 4) {
			box (100, 1, 1) color (0.85, 0.8, 0.5)
			box (1, 100, 1) color (0.85, 0.8, 0.5)
			box (1, 1, 100) color (0.85, 0.8, 0.5)
		}

		# level 4: holes of 0.67 in cells of 2
		repeat (2, 2, 2) limit (13, 13, 13) {
			box (100, 0.3333, 0.3333) color (0.6, 0.5, 0.75)
			box (0.3333, 100, 0.3333) color (0.6, 0.5, 0.75)
			box (0.3333, 0.3333, 100) color (0.6, 0.5, 0.75)
		}
	}
}